# Copy to config.env and fill in:   cp config.env.example config.env
# config.env is gitignored. Never commit it, and never put tokens in it.

# Where the runner registers: an organization (https://github.com/<org>)
# or a single repository (https://github.com/<owner>/<repo>).
GITHUB_URL=https://github.com/your-org

# Name shown on GitHub's runners page. Use something that identifies the machine, e.g. "<initials>-macbook".
RUNNER_NAME=your-runner-name

# Extra labels, comma-separated. GitHub adds self-hosted, macOS and ARM64 automatically.
# They must match the `runs-on:` of the jobs this runner should take.
RUNNER_LABELS=ios-build

# Runner group (organization runners only). Leave as Default unless your admin says otherwise.
RUNNER_GROUP=Default

# Repositories (owner/repo, space-separated) checked to show which workflow and who triggered a job.
# Needs the GitHub CLI (gh) logged in. Leave empty to skip.
WATCH_REPOS="your-org/your-app"

# The Xcode the runner builds with (kept separate from the Xcode you use day to day).
XCODE_APP=/Applications/Xcode-26.5.app

# GitHub Actions runner version to install (https://github.com/actions/runner/releases).
RUNNER_VERSION=2.337.0

# The separate macOS user the runner runs as.
RUNNER_USER=ci-runner

# Optional: phone notifications through https://ntfy.sh — pick a long random topic name.
NTFY_TOPIC=
